# Frontend / same-origin API
VITE_API_BASE_URL=/api

# Dean authentication
DEAN_EMAIL=dean@sggs.ac.in
DEAN_PASSWORD=replace-with-a-strong-14-plus-character-password
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Persistent CMS + audit storage (Upstash Redis REST)
# Keep these server-only; never prefix them with VITE_.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-server-token

# Cloudinary server credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional AI copilot
GROQ_API_KEY=replace-with-server-key
GROQ_MODEL=openai/gpt-oss-20b

# Optional cross-origin frontend deployments
FRONTEND_URL=https://your-frontend.vercel.app
PUBLIC_APP_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app
